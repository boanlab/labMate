# LabMate 환경설정 — 복사해서 .env 로 사용하고 값을 바꾸세요.
ENV=development
GATEWAY_PORT=8080

# PostgreSQL
POSTGRES_USER=labmate
POSTGRES_PASSWORD=change-me-strong-password

# JWT (모든 서비스가 공유. 운영 시 반드시 변경)
#   생성 예: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# 첫 배포 시 자동 생성되는 관리자 계정 (이미 관리자가 있으면 건너뜀)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=labmate-admin-1234

# Web Push(PWA) — 선택. 미설정 시 인앱 알림만, 설정 시 브라우저·모바일 푸시 활성.
#   공개키=uncompressed point, 개인키=raw 32B scalar (둘 다 base64url). HTTPS(또는 localhost)에서만 동작.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 첨부 — 한 개당 상한(MB). gateway 의 client_max_body_size(100m) 보다 작아야 한다.
MAX_UPLOAD_MB=30
# 첨부 다운로드 쿠키 수명(시간). 로그아웃하면 즉시 폐기된다.
DOWNLOAD_TOKEN_HOURS=12
