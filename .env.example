# LabMate 환경설정 — 복사해서 .env 로 사용하고 값을 바꾸세요.
ENV=development
GATEWAY_PORT=8090

# PostgreSQL
POSTGRES_USER=labmate
POSTGRES_PASSWORD=change-me-strong-password

# JWT (모든 서비스가 공유. 운영 시 반드시 변경)
#   생성 예: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# 첫 배포 시 자동 생성되는 관리자 계정 (이미 관리자가 있으면 건너뜀)
ADMIN_EMAIL=labmate@kloud.zone
ADMIN_PASSWORD=labmate123

# Web Push(PWA) — 선택. 미설정 시 인앱 알림만, 설정 시 브라우저·모바일 푸시 활성.
#   공개키=uncompressed point, 개인키=raw 32B scalar (둘 다 base64url). HTTPS(또는 localhost)에서만 동작.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
